# Release signing configuration for the inspection (:app) and admin (:admin-app) release builds.
#
# Copy this file to `keystore.properties` (which is git-ignored) and fill in real values, OR just
# run `./build.sh` and choose to generate a keystore — the script writes this file for you.
#
# storeFile may be absolute or relative to the repo root (e.g. keystore/vsp-release.jks).
# When keystore.properties is absent, release builds are produced UNSIGNED.

storeFile=keystore/vsp-release.jks
storePassword=Vsp@Release2026
keyAlias=vsp
keyPassword=Vsp@Release2026
