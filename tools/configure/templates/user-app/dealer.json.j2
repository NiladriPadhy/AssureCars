{
  "_comment": "Generated by tools/configure — do not edit by hand. Dealer: {{ dealer.id }}",
  "dealerId": "{{ dealer.id }}",
  "displayName": "{{ dealer.displayName }}",
  "apiBaseUrl": "{{ mobile.userApp.apiBaseUrl }}",
  "clientId": "{{ mobile.userApp.clientId }}",
  "bundleId": "{{ mobile.userApp.bundleId }}",
  "branding": {
    "primaryColor": "{{ branding.primaryColor }}",
    "secondaryColor": "{{ branding.secondaryColor }}",
    "accentColor": "{{ branding.accentColor }}",
    "logoUrl": "{{ infrastructure.storage.publicBaseUrl }}/branding/logo.png"
  },
  "support": {
    "phone": "{{ dealer.supportPhone }}",
    "email": "{{ dealer.supportEmail }}"
  },
  "locale": "{{ dealer.locale }}",
  "timezone": "{{ dealer.timezone }}",
  "features": {
    "sellRequest": {{ features.sellRequest | lower }},
    "pdiRequest": {{ features.pdiRequest | lower }},
    "reviews": {{ features.reviews | lower }}
  }
}
