# Generated by tools/configure — do not edit by hand.
# Dealer: {{ dealer.id }}

services:
  webapi:
    environment:
      DEALER_ID: {{ dealer.id }}
      ASPNETCORE_ENVIRONMENT: Production
    labels:
      - "assurecars.dealer={{ dealer.id }}"

  postgres:
    environment:
      POSTGRES_DB: {{ infrastructure.postgres.database }}
      POSTGRES_USER: {{ infrastructure.postgres.user }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}

  minio:
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD}

  caddy:
    environment:
      API_DOMAIN: {{ domains.api | replace('https://', '') | replace('http://', '') }}
      WEBSITE_DOMAIN: {{ domains.website | replace('https://', '') | replace('http://', '') }}
      ADMIN_DOMAIN: {{ domains.admin | replace('https://', '') | replace('http://', '') }}
