# Generated by tools/configure — do not edit by hand.
# Dealer: {{ dealer.id }} | {{ generatedAt }}

DEALER_ID={{ dealer.id }}
DEALER_DISPLAY_NAME={{ dealer.displayName }}

# Domains
API_URL={{ domains.api }}
WEBSITE_URL={{ domains.website }}
ADMIN_URL={{ domains.admin }}

# PostgreSQL
POSTGRES_HOST={{ infrastructure.postgres.host }}
POSTGRES_PORT={{ infrastructure.postgres.port }}
POSTGRES_DB={{ infrastructure.postgres.database }}
POSTGRES_USER={{ infrastructure.postgres.user }}
POSTGRES_PASSWORD={{ secrets.POSTGRES_PASSWORD }}

# Redis
REDIS_HOST={{ infrastructure.redis.host }}
REDIS_PORT={{ infrastructure.redis.port }}

# Object storage
STORAGE_TYPE={{ infrastructure.storage.type }}
STORAGE_BUCKET={{ infrastructure.storage.bucket }}
STORAGE_ENDPOINT={{ infrastructure.storage.endpoint }}
STORAGE_PUBLIC_BASE_URL={{ infrastructure.storage.publicBaseUrl }}
MINIO_ROOT_USER={{ secrets.MINIO_ROOT_USER }}
MINIO_ROOT_PASSWORD={{ secrets.MINIO_ROOT_PASSWORD }}
MINIO_ACCESS_KEY={{ secrets.MINIO_ACCESS_KEY }}
MINIO_SECRET_KEY={{ secrets.MINIO_SECRET_KEY }}

# API security
JWT_SIGNING_SECRET={{ secrets.JWT_SIGNING_SECRET }}
JWT_ISSUER={{ secrets.JWT_ISSUER }}
JWT_AUDIENCE={{ secrets.JWT_AUDIENCE }}

# Integrations
SMS_PROVIDER={{ integrations.sms.provider }}
MSG91_AUTH_KEY={{ secrets.MSG91_AUTH_KEY }}
MSG91_SENDER_ID={{ secrets.MSG91_SENDER_ID }}
EMAIL_PROVIDER={{ integrations.email.provider }}
SMTP_HOST={{ secrets.SMTP_HOST }}
SMTP_PORT={{ secrets.SMTP_PORT }}
SMTP_USER={{ secrets.SMTP_USER }}
SMTP_PASSWORD={{ secrets.SMTP_PASSWORD }}
EMAIL_FROM_ADDRESS={{ integrations.email.fromAddress }}
EMAIL_FROM_NAME={{ integrations.email.fromName }}
PUSH_PROVIDER={{ integrations.push.provider }}
FCM_SERVER_KEY={{ secrets.FCM_SERVER_KEY }}
MAPS_PROVIDER={{ integrations.maps.provider }}
GOOGLE_MAPS_API_KEY={{ secrets.GOOGLE_MAPS_API_KEY }}

# Bootstrap
ADMIN_INITIAL_EMAIL={{ bootstrap.admin.email }}
ADMIN_INITIAL_PASSWORD={{ secrets.ADMIN_INITIAL_PASSWORD }}

# CORS (comma-separated)
CORS_ORIGINS={{ domains.website }},{{ domains.admin }}

# Locale
DEALER_LOCALE={{ dealer.locale }}
DEALER_TIMEZONE={{ dealer.timezone }}
