{
  "_comment": "Generated by tools/configure — do not edit by hand. Dealer: {{ dealer.id }}",
  "Dealer": {
    "Id": "{{ dealer.id }}",
    "DisplayName": "{{ dealer.displayName }}",
    "LegalName": "{{ dealer.legalName }}",
    "Locale": "{{ dealer.locale }}",
    "Timezone": "{{ dealer.timezone }}",
    "DefaultCity": "{{ dealer.defaultCity }}",
    "SupportPhone": "{{ dealer.supportPhone }}",
    "SupportEmail": "{{ dealer.supportEmail }}"
  },
  "Domains": {
    "Api": "{{ domains.api }}",
    "Website": "{{ domains.website }}",
    "Admin": "{{ domains.admin }}"
  },
  "ConnectionStrings": {
    "Default": "Host={{ infrastructure.postgres.host }};Port={{ infrastructure.postgres.port }};Database={{ infrastructure.postgres.database }};Username={{ infrastructure.postgres.user }};Password={{ secrets.POSTGRES_PASSWORD }}"
  },
  "Redis": {
    "Host": "{{ infrastructure.redis.host }}",
    "Port": {{ infrastructure.redis.port }}
  },
  "Storage": {
    "Provider": "{{ infrastructure.storage.type }}",
    "Bucket": "{{ infrastructure.storage.bucket }}",
    "Endpoint": "{{ infrastructure.storage.endpoint }}",
    "PublicBaseUrl": "{{ infrastructure.storage.publicBaseUrl }}",
    "AccessKey": "{{ secrets.MINIO_ACCESS_KEY }}",
    "SecretKey": "{{ secrets.MINIO_SECRET_KEY }}"
  },
  "Jwt": {
    "Issuer": "{{ secrets.JWT_ISSUER }}",
    "Audience": "{{ secrets.JWT_AUDIENCE }}",
    "SigningSecret": "{{ secrets.JWT_SIGNING_SECRET }}"
  },
  "Cors": {
    "AllowedOrigins": [
      "{{ domains.website }}",
      "{{ domains.admin }}"
    ]
  },
  "Integrations": {
    "Sms": {
      "Provider": "{{ integrations.sms.provider }}",
      "Msg91AuthKey": "{{ secrets.MSG91_AUTH_KEY }}",
      "Msg91SenderId": "{{ secrets.MSG91_SENDER_ID }}"
    },
    "Email": {
      "Provider": "{{ integrations.email.provider }}",
      "SmtpHost": "{{ secrets.SMTP_HOST }}",
      "SmtpPort": {{ secrets.SMTP_PORT | default('587', true) }},
      "SmtpUser": "{{ secrets.SMTP_USER }}",
      "SmtpPassword": "{{ secrets.SMTP_PASSWORD }}",
      "FromAddress": "{{ integrations.email.fromAddress }}",
      "FromName": "{{ integrations.email.fromName }}"
    },
    "Push": {
      "Provider": "{{ integrations.push.provider }}",
      "FcmServerKey": "{{ secrets.FCM_SERVER_KEY }}"
    },
    "Maps": {
      "Provider": "{{ integrations.maps.provider }}",
      "GoogleApiKey": "{{ secrets.GOOGLE_MAPS_API_KEY }}"
    }
  },
  "FeatureFlags": {
    "SellRequest": {{ features.sellRequest | lower }},
    "PdiRequest": {{ features.pdiRequest | lower }},
    "Whatsapp": {{ features.whatsapp | lower }},
    "Reviews": {{ features.reviews | lower }}
  },
  "Clients": {
    "UserApp": { "ClientId": "{{ mobile.userApp.clientId }}" },
    "EmployeeApp": { "ClientId": "{{ mobile.employeeApp.clientId }}" },
    "InspectionApp": { "ClientId": "{{ mobile.inspectionApp.clientId }}" },
    "Website": { "ClientId": "{{ web.website.clientId }}" },
    "AdminPortal": { "ClientId": "{{ web.adminPortal.clientId }}" }
  }
}
