# Copy to secrets.env and fill in. NEVER commit secrets.env.
# Referenced by dealer.manifest.yaml → secretsRef

# --- Database ---
POSTGRES_PASSWORD=change-me-strong-password

# --- API security ---
JWT_SIGNING_SECRET=change-me-min-32-chars-random-string
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=assurecars

# --- Object storage (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ACCESS_KEY=assurecars
MINIO_SECRET_KEY=change-me-minio-secret

# --- Bootstrap admin (first login) ---
ADMIN_INITIAL_PASSWORD=change-me-on-first-login

# --- SMS (MSG91 example) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# --- Email (SMTP example) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Push (FCM) ---
FCM_SERVER_KEY=

# --- Maps ---
GOOGLE_MAPS_API_KEY=

# --- Inspection app (optional) ---
GEMINI_API_KEY=
FIREBASE_DB_URL=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
